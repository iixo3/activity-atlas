# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# local build and export artifacts
/output/

# large reproducible source downloads; keep compact continuity state
/data/raw/
/data/normalized/activity-series.csv
/data/normalized/.refresh.lock
/tsconfig.tsbuildinfo
